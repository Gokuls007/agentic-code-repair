# Copy to .env and fill in. .env is gitignored; never commit real keys.

# --- Secrets ---
GROQ_API_KEY=
ANTHROPIC_API_KEY=
GITHUB_TOKEN=
# Free key from https://build.nvidia.com (only used by the provider pool below)
NVIDIA_API_KEY=

# --- LLM: Groq free tier: THE BASELINE PROFILE (DECISIONS.md #19, #34) ---
# All experiments compared against the baseline must use this exact profile.
REPAIR_LLM__PROVIDER=groq
REPAIR_LLM__MODEL=openai/gpt-oss-120b
# Must call a tool every turn, so the agent can only stop by calling finish.
REPAIR_LLM__TOOL_CHOICE=required
# Clamped per request so prompt + completion fits the free tier's 8K tokens/minute.
REPAIR_LLM__MAX_OUTPUT_TOKENS=4096
REPAIR_LLM__GROQ_TPM_LIMIT=8000
REPAIR_LLM__GROQ_FREE_TIER=true
# Mapped to Groq's reasoning_effort for gpt-oss models: low | medium | high
REPAIR_LLM__EFFORT=medium
# Free-tier 429s carry retry-after; allow enough retries to wait them out.
REPAIR_LLM__MAX_RETRIES=8
# Longer waits (the daily token limit) end the attempt as infrastructure, so the eval stops
# and resumes later instead of sleeping away the attempt's time budget.
REPAIR_LLM__MAX_RETRY_WAIT_S=120

# --- LLM: provider pool: the same model on Groq + NVIDIA free tiers (DECISIONS.md #35) ---
# Keeps every setting above (same profile); balances requests across backends that have a
# key and fails over when one hits its daily limit. Check with `repair-agent ping` first.
# REPAIR_LLM__PROVIDER=pool
# REPAIR_LLM__POOL_STRATEGY=round_robin
# Custom backends as JSON (default: groq + nvidia, both clamped to 8000 tokens/minute):
# REPAIR_LLM__POOL=[{"name":"groq","kind":"groq","api_key_env":"GROQ_API_KEY","tpm_limit":8000},{"name":"nvidia","base_url":"https://integrate.api.nvidia.com/v1","api_key_env":"NVIDIA_API_KEY","tpm_limit":8000}]

# --- LLM: Groq Developer tier (paid): NOT the baseline profile (DECISIONS.md #33, #34) ---
# Results with this profile are not comparable to the free-tier baseline.
# REPAIR_LLM__MAX_OUTPUT_TOKENS=16000
# REPAIR_LLM__GROQ_TPM_LIMIT=250000
# REPAIR_LLM__GROQ_FREE_TIER=false
# and reset the context/tool limits below to their defaults:
# REPAIR_AGENT__CONTEXT_ELIDE_TOKENS=60000, REPAIR_AGENT__KEEP_RECENT_TURNS=4,
# REPAIR_TOOLS__MAX_OUTPUT_CHARS=12000, REPAIR_TOOLS__MAX_READ_LINES=400,
# REPAIR_TOOLS__MAX_SEARCH_RESULTS=100

# --- LLM: Anthropic (uncomment to switch; needs API credits) ---
# REPAIR_LLM__PROVIDER=anthropic
# REPAIR_LLM__MODEL=claude-sonnet-5
# REPAIR_LLM__TOOL_CHOICE=auto
# REPAIR_LLM__MAX_OUTPUT_TOKENS=16000
# REPAIR_LLM__MAX_RETRIES=3
# REPAIR_AGENT__CONTEXT_ELIDE_TOKENS=60000
# REPAIR_TOOLS__MAX_OUTPUT_CHARS=12000

# --- Per-task budgets ---
REPAIR_BUDGET__MAX_ITERATIONS=30
# Counts uncached input + cache writes + output (cache reads excluded). Groq's free tier
# allows ~200K tokens/day for gpt-oss-120b; keep one task well under that.
REPAIR_BUDGET__MAX_TOKENS_PER_TASK=150000
# Safety cap on the per-task list-price cost estimate (applies on the free tier too).
REPAIR_BUDGET__MAX_COST_USD_PER_TASK=0.05
REPAIR_BUDGET__MAX_TEST_RUNS=10
# Rate-limit waits make Groq runs slower in wall-clock terms.
REPAIR_BUDGET__WALL_CLOCK_TIMEOUT_S=1800

# --- Context management (small prompts for the 8K/minute limit) ---
REPAIR_AGENT__CONTEXT_ELIDE_TOKENS=4000
REPAIR_AGENT__KEEP_RECENT_TURNS=2

# --- Tool output truncation ---
REPAIR_TOOLS__MAX_OUTPUT_CHARS=6000
REPAIR_TOOLS__MAX_READ_LINES=200
REPAIR_TOOLS__MAX_SEARCH_RESULTS=50

# --- Docker sandbox (no network, non-root, limits below) ---
REPAIR_SANDBOX__IMAGE=repair-agent-sandbox:py3.11
REPAIR_SANDBOX__CPUS=1.0
REPAIR_SANDBOX__MEMORY_MB=1024
REPAIR_SANDBOX__PIDS_LIMIT=256
REPAIR_SANDBOX__TEST_TIMEOUT_S=120

# --- GitHub (Phase 5). Comma-separated owner/repo list. PRs are refused for anything else. ---
REPAIR_GITHUB__REPO_ALLOWLIST=

# --- Output ---
REPAIR_RUNS_DIR=runs
