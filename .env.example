# Copy to .env and fill in. .env is gitignored; never commit real keys.

# --- Secrets ---
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GITHUB_TOKEN=

# --- LLM ---
REPAIR_LLM__PROVIDER=anthropic
REPAIR_LLM__MODEL=claude-sonnet-5
REPAIR_LLM__MAX_OUTPUT_TOKENS=16000
# Optional: low | medium | high | xhigh | max (unset = model default)
# REPAIR_LLM__EFFORT=high

# --- Per-task budgets ---
REPAIR_BUDGET__MAX_ITERATIONS=30
REPAIR_BUDGET__MAX_TOKENS_PER_TASK=500000
REPAIR_BUDGET__MAX_TEST_RUNS=10
REPAIR_BUDGET__WALL_CLOCK_TIMEOUT_S=900

# --- Tool output truncation ---
REPAIR_TOOLS__MAX_OUTPUT_CHARS=12000
REPAIR_TOOLS__MAX_READ_LINES=400
REPAIR_TOOLS__MAX_SEARCH_RESULTS=100

# --- Docker sandbox (no network, non-root, limits below) ---
REPAIR_SANDBOX__IMAGE=repair-agent-sandbox:py3.11
REPAIR_SANDBOX__CPUS=1.0
REPAIR_SANDBOX__MEMORY_MB=1024
REPAIR_SANDBOX__PIDS_LIMIT=256
REPAIR_SANDBOX__TEST_TIMEOUT_S=120

# --- GitHub (Phase 5). Comma-separated owner/repo list. PRs are refused for anything else. ---
REPAIR_GITHUB__REPO_ALLOWLIST=

# --- Output ---
REPAIR_RUNS_DIR=runs
